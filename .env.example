# 环境变量模板。复制为 .env(DATABASE_URL)与 .env.local(其余),填入真值。
# .env* 已被 .gitignore 排除,不入库。

# ── 数据库(Postgres,必填)──
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"

# ── 检测后端(可选)──
# 站内「自带 Key 自测」功能依赖一个自建的检测服务;未配置时相关接口返回 501,其余页面不受影响。
# DETECT_BASE_URL="http://127.0.0.1:8000"

# ── 评分口径(可选,有通用缺省;按自己的运营口径调校)──
# 综合分 = (可用指数 × SCORE_W_AVAIL + 速度指数 × SCORE_W_SPEED) × 纯度系数
# SCORE_W_AVAIL=0.5
# SCORE_W_SPEED=0.5
# SCORE_COEF_PUREBLOOD=1.0
# SCORE_COEF_DOWNGRADE=1.0
# SCORE_COEF_COUNTERFEIT=1.0
# 速度分:FAST_MS 满分 / SLOW_MS 及以上 0 分
# SCORE_SPEED_FAST_MS=2000
# SCORE_SPEED_SLOW_MS=10000

# ── 发信(Resend;注册验证码 + 忘记密码邮件)──
# EMAIL_FROM 必须是 Resend 已验证域名的地址,否则发信失败/进垃圾箱。
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="YourSite <noreply@你的已验证域名>"

# ── Google 登录(OAuth)──
# 在 Google Cloud Console 建 OAuth 客户端;回调 URL 填 https://你的域名/api/auth/google/callback
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"

# ── 多语言机翻(Google Translate v2;预翻 DB 内容 + build-ui-dict 补 UI 字典)──
GOOGLE_TRANSLATE_API_KEY="xxxx"

# ── SEO / 站点绝对地址(sitemap、canonical、og 用)──
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# ── 上传目录(logo 等;线上指向持久卷,避免重启丢文件。默认 public/uploads)──
UPLOAD_DIR="/data/uploads"

# ── 翻译扫描调优(可选,有默认)──
# SCAN_CAP=200
# SCAN_CHAR_BUDGET=200000
